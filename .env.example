# Sustainashare Backend
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-char-random-string
MONGO_DETAILS=mongodb+srv://USER:PASSWORD@HOST/food_donation?retryWrites=true&w=majority
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_AUTH_PER_MINUTE=20
ENABLE_DOCS=true
# Bootstrap (CLI only — never commit real values)
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
